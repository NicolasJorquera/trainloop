  "notes": {
    "row1": {"x": 0, "y": -300, "text": "1 · Inicio y biblioteca", "kind": "title1", "maxW": 1800},
    "row2": {"x": 0, "y": 944, "text": "2 · Sesión de intervalos", "kind": "title1", "maxW": 1800},
