<?xml version="1.0" encoding="utf-8"?>
<!-- Copia automática de Android 12 o superior (android:dataExtractionRules):
     va al Google Drive de la persona y a la transferencia entre teléfonos.
     Solo la base y las preferencias; la caché nunca se respalda.
     Debe coincidir con backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="trainloop.sqlite" />
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="trainloop.sqlite" />
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
